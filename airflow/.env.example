# Copy to .env and fill in. .env is NOT committed (.gitignore).
SNOWFLAKE_ACCOUNT=ABCDEFG-XY12345
SNOWFLAKE_USER=YOUR_USER
# ABSOLUTE path of the folder on your computer that contains rsa_key.p8
PITWALL_KEYS_DIR=/Users/you/pitwall/keys
# ABSOLUTE path of a folder for the FastF1 cache (kept between runs: fewer API calls)
PITWALL_FASTF1_CACHE=/Users/you/pitwall/fastf1_cache
# ABSOLUTE path of the folder where you unzipped the Kaggle dataset (one-off backfill)
PITWALL_KAGGLE_DIR=/Users/you/pitwall/data/kaggle
# Slack or Teams incoming webhook for failure alerts (optional: without it the alert is a log line)
ALERT_WEBHOOK_URL=
